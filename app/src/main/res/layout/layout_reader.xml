<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_reader_window"
    android:elevation="12dp">

    <!-- Top bar: reading settings (Aa) on the left, fullscreen/minimize/close on the right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="6dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btnReaderSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Aa"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/dragHandle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="• • • •"
            android:textColor="#555A6E"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Move window" />

        <ImageView
            android:id="@+id/btnBookmark"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/ic_bookmark"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Bookmarks" />

        <ImageView
            android:id="@+id/btnFullscreen"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/ic_fullscreen"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Fullscreen" />

        <ImageView
            android:id="@+id/btnMinimize"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/ic_minimize"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Minimize" />

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close book" />
    </LinearLayout>

    <!-- Reading progress: persentase keseluruhan buku, bukan cuma posisi chapter -->
    <ProgressBar
        android:id="@+id/readingProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#4A90E2"
        android:progressBackgroundTint="#33FFFFFF" />

    <!-- Reading settings panel: hidden (GONE) until the "Aa" button is tapped -->
    <LinearLayout
        android:id="@+id/readerSettingsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_settings_panel"
        android:layout_margin="8dp"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtReadingModeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reading Mode"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnThemeDay"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:background="@drawable/bg_theme_chip_day"
                android:textColor="#1A1A1A"
                android:textAllCaps="false"
                android:text="Day" />

            <Button
                android:id="@+id/btnThemeNight"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:background="@drawable/bg_theme_chip_night"
                android:textColor="#E0E0E0"
                android:textAllCaps="false"
                android:text="Night" />

            <Button
                android:id="@+id/btnThemeSepia"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:background="@drawable/bg_theme_chip_sepia"
                android:textColor="#5B4636"
                android:textAllCaps="false"
                android:text="Sepia" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtFontSizeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Font Size"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/btnFontSmaller"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="−"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:background="@drawable/bg_round_button"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/txtFontSize"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="18"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnFontBigger"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:background="@drawable/bg_round_button"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtFontFamilyLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Font Family"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerFontFamily"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

    </LinearLayout>

    <!-- Panel bookmark: disembunyikan (GONE) sampai tombol bookmark ditekan -->
    <LinearLayout
        android:id="@+id/bookmarkPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_settings_panel"
        android:layout_margin="8dp"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/txtBookmarksLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bookmarks"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnAddBookmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="+ Add here"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:background="@drawable/bg_round_button"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtNoBookmarks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No bookmarks yet for this book."
            android:textColor="#666A7A"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/bookmarkListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

    <!-- WebView + resize handle at the bottom-right corner -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <android.webkit.WebView
            android:id="@+id/webViewContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/resizeHandle"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="bottom|end"
            android:padding="4dp"
            android:src="@drawable/ic_resize_handle"
            android:contentDescription="Resize window" />
    </FrameLayout>

    <!-- Chapter navigation: compact arrow-only buttons so the footer stays small -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnPrevChapter"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="2dp"
            android:textSize="13sp"
            android:textColor="#4A90E2"
            android:text="&lt;&lt;&lt;" />

        <TextView
            android:id="@+id/txtChapterPosition"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:text="" />

        <Button
            android:id="@+id/btnNextChapter"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="2dp"
            android:textSize="13sp"
            android:textColor="#4A90E2"
            android:text="&gt;&gt;&gt;" />

    </LinearLayout>

</LinearLayout>
