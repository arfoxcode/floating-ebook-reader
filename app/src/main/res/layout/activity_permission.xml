<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#14141C">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="App Permissions"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <Button
                android:id="@+id/btnEnableOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Enable floating bubble" />

            <Button
                android:id="@+id/btnEnableStorage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Allow storage access" />

            <Button
                android:id="@+id/btnDisableBatteryOptimization"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Run without battery optimization" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="20dp"
                android:background="#33FFFFFF" />

            <TextView
                android:id="@+id/txtVendorSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Background Run Guide"
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtVendorIntro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp"
                android:text="Some phone brands have their own battery manager that can still stop this app even after the permission above is granted."
                android:textColor="#666A7A"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/txtVendorName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtVendorInstructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:textColor="#AAAAAA"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnOpenVendorSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Open Vendor Settings" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="20dp"
                android:background="#33FFFFFF" />

            <Button
                android:id="@+id/btnDeviceAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enable device admin" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
